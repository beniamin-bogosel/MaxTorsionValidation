func real stdev(real[int] &V){
   real av = V.sum/V.n;
   real sd = 0;
   for(int i=0;i<V.n;i++){
      sd = sd+(V[i]-av)^2;
   }
   return sqrt(sd/V.n);
}

/// start calcarea function

func real[int] calcarea(real[int] &vect){
   real Area = 0;
   real[int] xx = vect(ix);
   real[int] yy = vect(iy);
   cout << xx << endl;
   cout << yy << endl;
   real[int] gradt(vect.n);
   for(int j=0;j<n;j++){
       Area+=0.5*(xx[j]*yy[ind3[j]]-xx[ind3[j]]*yy[j]);
       gradt(2*j) = 0.5*(yy[ind3[j]]-yy[ind2[j]]);
       gradt(2*j+1) = 0.5*(xx[ind2[j]]-xx[ind3[j]]);
   }
   real[int] res;
   res = [Area,gradt];
   return res;
}

real[int,int] HessArea(2*n,2*n);
HessArea = 0;
for(int i=0;i<n;i++){
   int ni = (i+1)%n;
   HessArea(2*ni+1,2*i)=0.5;
   HessArea(2*i+1,2*ni)=-0.5;
   HessArea(2*i,2*ni+1)=0.5;
   HessArea(2*ni,2*i+1)=-0.5;
}



