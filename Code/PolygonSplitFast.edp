/// start polya function
func real[int,int] PolygonSplit(real[int] &vect,int HessComp){

	int halfsize = vect.n/2;
	real[int] xx(halfsize);
	real[int] yy(halfsize);
  
   xx = vect(ix);
   yy = vect(iy);

   real[int] xs(3),ys(3);

   border tr(t=0,1; i){
    	int ni = (i+1)%3;
    	x=(1-t)*xs[i]+t*xs[ni]; 
    	y=(1-t)*ys[i]+t*ys[ni];
    	label=i;
	}
  
   mesh[int] Tri(halfsize);
   mesh Th;
   for(int i=0;i<halfsize;i++){
      int ni = (i+1)%n;
      xs[0] = xx[i];
      xs[1] = xx[ni];
      ys[0] = yy[i];
      ys[1] = yy[ni];
      xs[2] = cx;
      ys[2] = cy;
      int[int] nnn = [1,1,1];
      Tri[i] = buildmesh(tr(nnn));
      //plot(Tri[i],wait=0); 
      Th = Th+Tri[i];
   }
   mesh Th0 = Th;
	//Th= adaptmesh(Th,1./100,IsMetric=1,nbvx=20000);
   cout << "Vertices: " << Th.nv << endl;
   //plot(Th0,wait=1);
   fespace Vh00(Th0,P0);
   fespace Vh01(Th0,P1);
   Vh00 reg = region;
   Vh00 regions = 0;
   for(int i=0;i<halfsize;i++){
      regions = regions+i*chi(Tri[i]);
   } 
   Th = trunc(Th0,1,split=meshp);
   fespace Vh(Th,Pk);
   fespace Vh0(Th,Pk0);
   Vh u,v;
   problem Lap(u,v) = int2d(Th)(grad(u)'*grad(v))
                     -int2d(Th)(v)
                     +on(0,u=0);
   //plot(regions,fill=1,cmm="Regions");
   Lap;
   plot(u,fill=1);// Solution for the torsion function
   real[int] result;
  
   Vh0 grh = 0.5*(dx(u)^2+dy(u)^2)-u;
   val = 0.5*int2d(Th)(u);
   Vh01 phi0;
   Vh phi,Unk,Unkx,Unky;
   Vh[int] Ux(n),Uy(n);
   Vh[int] Phi(n);
   problem Solvex(Unkx,v) 
        = int2d(Th)(grad(Unkx)'*grad(v))
         +int2d(Th)(grad(u)'*grad(v)*dx(phi))
         -int2d(Th)(grad(v)'*grad(phi)*dx(u)+grad(u)'*grad(phi)*dx(v))
         -int2d(Th)(v*dx(phi))
         +on(0,Unkx=0);
	problem Solvey(Unky,v) 
        = int2d(Th)(grad(Unky)'*grad(v))
         +int2d(Th)(grad(u)'*grad(v)*dy(phi))
         -int2d(Th)(grad(v)'*grad(phi)*dy(u)+grad(u)'*grad(phi)*dy(v))
         -int2d(Th)(v*dy(phi))
         +on(0,Unky=0);

   int[int] index(n);
   // Detect indices for vertices...
   for(int i=0;i<Th0.nv;i++){
      for(int j=0;j<n;j++){
          if(abs(Th0(i).x-xx[j])+abs(Th0(i).y-yy[j])<1e-6){
              index[j] = i;
              break;
          }
      }
   } 
   cout << index << endl;

   for(int i = 0;i<n;i++){
      // Choose only outer vertices

         // Construct P1 piecewise affine on sides, 0,1 at vertices
      	phi0[] = 0;
      	phi0[][Th0(index(i))] = 1;
         phi = phi0;
         Phi[i][] = phi[];
      	//plot(phi,fill=1,wait=1,cmm="vertex "+i);
         Solvex; Ux[i][] = Unkx[]; //plot(Unk,fill=1,wait=1,cmm="Ux"+i);
			Solvey; Uy[i][] = Unky[]; //plot(Unk,fill=1,wait=1,cmm="Uy"+i);
	  gradE[2*i]   = int2d(Th)(-grh*dx(phi)+grad(u)'*grad(phi)*dx(u));
     gradE[2*i+1] = int2d(Th)(-grh*dy(phi)+grad(u)'*grad(phi)*dy(u));
   }
   if(HessComp==1){
   real[int,int] M(2*n,2*n);
   M = 0;
   Vh0[int] dxUx(n),dyUx(n),dxUy(n),dyUy(n);
   Vh0[int] dxPhi(n),dyPhi(n);
   Vh0 dxu=dx(u),dyu=dy(u);
   for(int i=0;i<n;i++){
      dxUx[i] = dx(Ux[i]);
      dyUx[i] = dy(Ux[i]);
      dxUy[i] = dx(Uy[i]);
      dyUy[i] = dy(Uy[i]);
      dxPhi[i] = dx(Phi[i]);
      dyPhi[i] = dy(Phi[i]);
   }
   real cc = clock();
   for(int i=0;i<n;i++){
      for(int j=0;j<n;j++){
          M(2*i,2*j) = int2d(Th)(dxUx[j]*dxUx[i]+dyUx[j]*dyUx[i]
                      	        +(dxu*dxPhi[i]+dyu*dyPhi[i])*dxPhi[j]*dxu
                                +(dxu*dxPhi[j]+dyu*dyPhi[j])*dxu*dxPhi[i]
                       			  -(dxPhi[j]*dxu+dyPhi[j]*dyu)*dxPhi[i]*dxu
                                -(dxPhi[i]*dxu+dyPhi[i]*dyu)*dxu*dxPhi[j]
                                -(dxPhi[i]*dxPhi[j]+dyPhi[i]*dyPhi[j])*dxu*dxu);
      M(2*i+1,2*j+1) = int2d(Th)([dxUy[j],dyUy[j]]'*[dxUy[i],dyUy[i]]
                                 +(dxu*dxPhi[i]+dyu*dyPhi[i])*dyPhi[j]*dyu
                                 +(dxu*dxPhi[j]+dyu*dyPhi[j])*dyu*dyPhi[i]
                                 -(dxPhi[j]*dxu+dyPhi[j]*dyu)*dyPhi[i]*dyu
                                 -(dxPhi[i]*dxu+dyPhi[i]*dyu)*dyu*dyPhi[j]
                                 -(dxPhi[i]*dxPhi[j]+dyPhi[i]*dyPhi[j])*dyu*dyu);
      M(2*i+1,2*j)   = int2d(Th)([dxUx[j],dyUx[j]]'*[dxUy[i],dyUy[i]]
                                +[dxu,dyu]'*[dxPhi[i],dyPhi[i]]*dxPhi[j]*dyu
                                +[dxu,dyu]'*[dxPhi[j],dyPhi[j]]*dxu*dyPhi[i]
                                +grh*(dxPhi[i]*dyPhi[j]-dyPhi[i]*dxPhi[j])
                                -[dxPhi[j],dyPhi[j]]'*[dxu,dyu]*dxPhi[i]*dyu
                                -[dxPhi[i],dyPhi[i]]'*[dxu,dyu]*dxu*dyPhi[j]
                                -[dxPhi[i],dyPhi[i]]'*[dxPhi[j],dyPhi[j]]*dxu*dyu);
      M(2*i,2*j+1)   = int2d(Th)([dxUy[j],dyUy[j]]'*[dxUx[i],dyUx[i]]
                                +[dxu,dyu]'*[dxPhi[i],dyPhi[i]]*dyPhi[j]*dxu
                                +[dxu,dyu]'*[dxPhi[j],dyPhi[j]]*dyu*dxPhi[i]
                                +grh*(-dxPhi[i]*dyPhi[j]+dyPhi[i]*dxPhi[j])
                                -[dxPhi[j],dyPhi[j]]'*[dxu,dyu]*dyPhi[i]*dxu
                                -[dxPhi[i],dyPhi[i]]'*[dxu,dyu]*dyu*dxPhi[j]
                                -[dxPhi[i],dyPhi[i]]'*[dxPhi[j],dyPhi[j]]*dyu*dxu);
      }
   }
   cout << "Hess time: " << clock()-cc << endl;
   return M;
   }
}
/// end Polya function

PolygonSplit(dplus,0);
real v1 = val;
