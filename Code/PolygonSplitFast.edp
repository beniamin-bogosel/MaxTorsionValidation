real[int,int] GlobalHess(2*n,2*n);




real[int] gradArea = AreaRes(1:AreaRes.n-1);
real[int] fact = gradArea./gradE;

real kappa;

for(int i=0;i<2*n;i++){
   if(abs(gradArea[i])>1e-3){
      kappa = gradE[i]/gradArea[i]/val^2;
   }
}

real[int] rescGrad = val^2*kappa*gradArea;
