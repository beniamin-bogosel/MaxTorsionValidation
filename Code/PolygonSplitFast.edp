real[int,int] MidMat(2*n,2*n);
MidMat  = gradE*gradE';

cout << "MidMat: " << MidMat << endl;

GlobalHess=0;
GlobalHess = -1/val^2*Mat+2/val^3*MidMat;
GlobalHess = GlobalHess+kappa*HessArea;
cout << GlobalHess << endl;


if(1==0){
matrix A = GlobalHess;
real[int,int] B0(2*n,2*n);
B0 = 0;
for(int i=0;i<2*n;i++){
  B0(i,i)=1;
}
matrix B = B0;
