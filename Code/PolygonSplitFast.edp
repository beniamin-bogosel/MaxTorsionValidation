cout << B << endl;
real[int] ev(2*n);

func real[int] AP(real[int] &vect){
    real[int] res = GlobalHess*vect; 
    return res;
} 

int nc = EigenValue(A,B,value=ev,nev=2*n,ncv=2*n,sigma=0);
cout << nc << "  " << ev << endl;
