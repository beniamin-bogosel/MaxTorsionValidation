// Modewise benchmark for the sharp second-variation residual bound.
// Directions are selected by (axis,phase): axis 0=radial, 1=tangential;
// phase 0=cos(k*i*theta), 1=sin(k*i*theta).
// Example: FreeFem++ -nw second_variation_lifting.edp -n 5 -m 32 -k 2

include "macro_ddm.idp"
verbosity = 0;
cout.precision(16);
macro grad(u) [dx(u),dy(u)] //

int n=getARGV("-n",5), m=getARGV("-m",16), kMode=getARGV("-k",2);
int qAxis=getARGV("-qa",0), qPhase=getARGV("-qp",0);
int rAxis=getARGV("-ra",0), rPhase=getARGV("-rp",0);
string exportSecond=getARGV("-export-second","");
real theta=2*pi/n;

real[int] vx(n),vy(n);
for(int i=0;i<n;++i){vx[i]=cos(i*theta);vy[i]=sin(i*theta);}
real[int] sx(3),sy(3);
border fan(t=0,1;q){int qn=(q+1)%3;x=(1-t)*sx[q]+t*sx[qn];
  y=(1-t)*sy[q]+t*sy[qn];label=q;}
mesh[int] sector(n); mesh coarse;
for(int i=0;i<n;++i){int ip=(i+1)%n;
  sx[0]=vx[i];sy[0]=vy[i];sx[1]=vx[ip];sy[1]=vy[ip];sx[2]=0;sy[2]=0;
  int[int] one=[1,1,1];sector[i]=buildmesh(fan(one));coarse=coarse+sector[i];}
mesh Th=trunc(coarse,1,split=m);
fespace Vc(coarse,P1); fespace Vh(Th,P1); fespace P0h(Th,P0);
fespace P1dh(Th,P1dc);

int[int] coarseVertex(n);
for(int p=0;p<coarse.nv;++p)for(int i=0;i<n;++i)
  if(abs(coarse(p).x-vx[i])+abs(coarse(p).y-vy[i])<1e-8)coarseVertex[i]=p;

// Unit Euclidean vertex directions in the requested real Fourier modes.
Vc qcx,qcy,rcx,rcy; qcx[]=0;qcy[]=0;rcx[]=0;rcy[]=0;
real nq=0,nr=0;
for(int i=0;i<n;++i){
  real cq=(qPhase==0)?cos(kMode*i*theta):sin(kMode*i*theta);
  real cr=(rPhase==0)?cos(kMode*i*theta):sin(kMode*i*theta);
  real qx=(qAxis==0)?vx[i]:-vy[i], qy=(qAxis==0)?vy[i]:vx[i];
  real rx=(rAxis==0)?vx[i]:-vy[i], ry=(rAxis==0)?vy[i]:vx[i];
  qcx[][coarseVertex[i]]=cq*qx;qcy[][coarseVertex[i]]=cq*qy;
  rcx[][coarseVertex[i]]=cr*rx;rcy[][coarseVertex[i]]=cr*ry;
  nq+=cq^2;nr+=cr^2;
}
if(nq<1e-14 || nr<1e-14){cout<<"invalid zero Fourier direction"<<endl;exit(2);}
qcx[]=qcx[]/sqrt(nq);qcy[]=qcy[]/sqrt(nq);
rcx[]=rcx[]/sqrt(nr);rcy[]=rcy[]/sqrt(nr);
Vh qx=qcx,qy=qcy,rx=rcx,ry=rcy;

// Q=D theta_q and R=D theta_r, with rows equal to component gradients.
P0h a=dx(qx),b=dy(qx),c=dx(qy),d=dy(qy);
P0h e=dx(rx),f=dy(rx),g=dx(ry),hh=dy(ry);
P0h tq=a+d,tr=e+hh,dqr=tq*tr-(a*e+b*g+c*f+d*hh);
P0h Aq11=tq-2*a,Aq12=-(b+c),Aq22=tq-2*d;
P0h Ar11=tr-2*e,Ar12=-(f+g),Ar22=tr-2*hh;

// A_qr = D_qr I + tr(Q)B_r + tr(R)B_q + B_qr for
// A(F)=det(F) F^{-1}F^{-T} at F=I.
P0h S11=2*(a*e+b*g+e*a+f*c)+2*(a*e+b*f);
P0h S22=2*(c*f+d*hh+g*b+hh*d)+2*(c*g+d*hh);
P0h S12=(a*f+b*hh+e*b+f*d+c*e+d*g+g*a+hh*c)
          +(a*g+b*hh+e*c+f*d);
P0h Aqr11=dqr-tq*(2*e)-tr*(2*a)+S11;
P0h Aqr12=-tq*(f+g)-tr*(b+c)+S12;
P0h Aqr22=dqr-tq*(2*hh)-tr*(2*d)+S22;

Vh u,v,uq,ur,zh;
problem state(u,v,solver=CG,eps=1e-13)=int2d(Th)(grad(u)'*grad(v))
  -int2d(Th)(v)+on(0,u=0);
problem firstQ(uq,v,solver=CG,eps=1e-13)=int2d(Th)(grad(uq)'*grad(v))
  +int2d(Th)(Aq11*dx(u)*dx(v)+Aq12*(dx(u)*dy(v)+dy(u)*dx(v))
             +Aq22*dy(u)*dy(v)-tq*v)+on(0,uq=0);
problem firstR(ur,v,solver=CG,eps=1e-13)=int2d(Th)(grad(ur)'*grad(v))
  +int2d(Th)(Ar11*dx(u)*dx(v)+Ar12*(dx(u)*dy(v)+dy(u)*dx(v))
             +Ar22*dy(u)*dy(v)-tr*v)+on(0,ur=0);
problem lifting(zh,v,solver=CG,eps=1e-13)=int2d(Th)(grad(zh)'*grad(v))
  +int2d(Th)(Aq11*dx(ur)*dx(v)+Aq12*(dx(ur)*dy(v)+dy(ur)*dx(v))+Aq22*dy(ur)*dy(v)
             +Ar11*dx(uq)*dx(v)+Ar12*(dx(uq)*dy(v)+dy(uq)*dx(v))+Ar22*dy(uq)*dy(v)
             +Aqr11*dx(u)*dx(v)+Aqr12*(dx(u)*dy(v)+dy(u)*dx(v))+Aqr22*dy(u)*dy(v)
             -dqr*v)+on(0,zh=0);
state;firstQ;firstR;lifting;

// Curl-potential fit for q_flux=base+curl(psi), retaining exact divergence.
Vh psi,test;
Vh Psi0,PsiQ,PsiR,PsiZ;
P1dh baseX,baseY;
P0h targetX,targetY;
real meanPenalty=1e-12;
// This auxiliary tolerance changes only flux optimization; the exported
// potential always defines an admissible flux checked by the C verifier.
real fluxEps=getARGV("-flux-eps",1e-13);
assert(fluxEps>0);
problem fitCurl(psi,test,solver=CG,eps=fluxEps)=
  int2d(Th)(grad(psi)'*grad(test)+meanPenalty*psi*test)
 +int2d(Th)((baseX-targetX)*dy(test)-(baseY-targetY)*dx(test));

baseX=-x/2;baseY=-y/2;targetX=dx(u);targetY=dy(u);psi[]=0;fitCurl;
Psi0[]=psi[];
real delta0=sqrt(int2d(Th)((baseX+dy(psi)-targetX)^2+(baseY-dx(psi)-targetY)^2));

// First direction q: G=-A_q grad(u), so target=grad(u_q)-G.
baseX=-qx;baseY=-qy;
targetX=dx(uq)+Aq11*dx(u)+Aq12*dy(u);
targetY=dy(uq)+Aq12*dx(u)+Aq22*dy(u);psi[]=0;fitCurl;
PsiQ[]=psi[];
real fluxQ=sqrt(int2d(Th)((baseX+dy(psi)-targetX)^2+(baseY-dx(psi)-targetY)^2));
P0h opQ=(abs(Aq11+Aq22)+sqrt((Aq11-Aq22)^2+4*Aq12^2))/2;
real deltaQ=fluxQ+opQ[].max*delta0;

baseX=-rx;baseY=-ry;
targetX=dx(ur)+Ar11*dx(u)+Ar12*dy(u);
targetY=dy(ur)+Ar12*dx(u)+Ar22*dy(u);psi[]=0;fitCurl;
PsiR[]=psi[];
real fluxR=sqrt(int2d(Th)((baseX+dy(psi)-targetX)^2+(baseY-dx(psi)-targetY)^2));
P0h opR=(abs(Ar11+Ar22)+sqrt((Ar11-Ar22)^2+4*Ar12^2))/2;
real deltaR=fluxR+opR[].max*delta0;

// div((div q)r-Dq r)=d_qr, including distributionally across fitted edges.
baseX=-tq*rx+a*rx+b*ry;
baseY=-tq*ry+c*rx+d*ry;
targetX=dx(zh)+Aq11*dx(ur)+Aq12*dy(ur)
              +Ar11*dx(uq)+Ar12*dy(uq)+Aqr11*dx(u)+Aqr12*dy(u);
targetY=dy(zh)+Aq12*dx(ur)+Aq22*dy(ur)
              +Ar12*dx(uq)+Ar22*dy(uq)+Aqr12*dx(u)+Aqr22*dy(u);
psi[]=0;fitCurl;
PsiZ[]=psi[];
real eta=sqrt(int2d(Th)((baseX+dy(psi)-targetX)^2+(baseY-dx(psi)-targetY)^2));
P0h opQR=(abs(Aqr11+Aqr22)+sqrt((Aqr11-Aqr22)^2+4*Aqr12^2))/2;
real Mqr=opQR[].max;
real secondBound=deltaQ*deltaR+0.5*Mqr*delta0^2+delta0*eta;
real Jhess=int2d(Th)(dqr*u+tq*ur
  -0.5*(Aqr11*dx(u)^2+2*Aqr12*dx(u)*dy(u)+Aqr22*dy(u)^2)
  -(dx(ur)*(Aq11*dx(u)+Aq12*dy(u))
    +dy(ur)*(Aq12*dx(u)+Aq22*dy(u))));
real area=Th.measure, Jh=0.5*int2d(Th)(u), HAqr=int2d(Th)(dqr);
real Fhess=Jhess/area^2-2*Jh/area^3*HAqr;

cout<<"SECOND_SUMMARY n="<<n<<" m="<<m<<" k="<<kMode
    <<" qa="<<qAxis<<" qp="<<qPhase<<" ra="<<rAxis<<" rp="<<rPhase
    <<" dof="<<Vh.ndof<<" J="<<Jh<<endl;
cout<<"SECOND_BOUND delta0="<<delta0<<" fluxQ="<<fluxQ<<" deltaQ="<<deltaQ
    <<" fluxR="<<fluxR<<" deltaR="<<deltaR<<" eta="<<eta
    <<" Mqr="<<Mqr<<" J_hessian_center="<<Jhess
    <<" J_hessian_error="<<secondBound<<" HAqr="<<HAqr
    <<" F_hessian_center="<<Fhess<<endl;

if(exportSecond!=""){
  ofstream cert(exportSecond);cert.precision(17);
  cert<<"TORSION_SECOND_V2 "<<n<<" "<<m<<" "<<kMode<<" "
      <<qAxis<<" "<<qPhase<<" "<<rAxis<<" "<<rPhase<<" "
      <<Th.nv<<" "<<Th.nt<<endl;
  for(int p=0;p<Th.nv;++p)cert<<Th(p).x<<" "<<Th(p).y<<endl;
  for(int t=0;t<Th.nt;++t)cert<<int(Th[t][0])<<" "<<int(Th[t][1])<<" "<<int(Th[t][2])<<endl;
  for(int p=0;p<Th.nv;++p)cert<<qx(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<qy(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<rx(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<ry(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<u(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<uq(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<ur(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<zh(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<Psi0(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<PsiQ(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<PsiR(Th(p).x,Th(p).y)<<endl;
  for(int p=0;p<Th.nv;++p)cert<<PsiZ(Th(p).x,Th(p).y)<<endl;
  cout<<"SECOND exported="<<exportSecond<<endl;
}
